DATABASE_URL=postgresql://postgres@localhost:6543/shule_tutor
JWT_SECRET=replace_with_a_long_random_secret

# Daraja / Safaricom M-Pesa settings for deployment.
# Add these in Render and replace the values when going live.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://your-render-app.onrender.com/api/payments/mpesa/callback
MPESA_TRANSACTION_PREFIX=SHULE

# For Render later, replace with the deployed Postgres connection string.
# Example:
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>
